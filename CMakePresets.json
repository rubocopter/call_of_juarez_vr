{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "win32-debug",
      "displayName": "Win32 Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/win32-debug",
      "cacheVariables": {
        "COJVR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "win32-openvr-only",
      "displayName": "Win32 OpenVR only",
      "inherits": "win32-debug",
      "binaryDir": "${sourceDir}/build/win32-openvr-only",
      "cacheVariables": {
        "COJVR_ENABLE_OPENVR": "ON",
        "COJVR_ENABLE_OPENXR": "OFF"
      }
    },
    {
      "name": "win32-openxr-only",
      "displayName": "Win32 OpenXR only",
      "inherits": "win32-debug",
      "binaryDir": "${sourceDir}/build/win32-openxr-only",
      "cacheVariables": {
        "COJVR_ENABLE_OPENVR": "OFF",
        "COJVR_ENABLE_OPENXR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "win32-debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "win32-debug",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "win32-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "win32-debug",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
